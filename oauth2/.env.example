KU_ALLLOGIN_USERINFO_URL=https://alllogin.ku.ac.th/realms/KU-Alllogin/protocol/openid-connect/userinfo
KU_ALLLOGIN_END_SESSION_URL=https://alllogin.ku.ac.th/realms/KU-Alllogin/protocol/openid-connect/logout
