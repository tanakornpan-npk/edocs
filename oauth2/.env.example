# Client Credentials
KU_ALLLOGIN_CLIENT_ID=csc-it-service
KU_ALLLOGIN_CLIENT_SECRET=wtDtbff5rcZTKOeyPQC2AWGEAq8ZvQh6
KU_ALLLOGIN_SCOPE=basic openid

# URIs / Redirects
APP_URL=https://service.csc.ku.ac.th/edocs
KU_ALLLOGIN_REDIRECT_URI=https://service.csc.ku.ac.th/edocs/oauth2
